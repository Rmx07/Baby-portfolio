# ---- Local / preview database (Drizzle + node-postgres) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- AI (server-side only, never NEXT_PUBLIC_) ----
# Create a key at https://aistudio.google.com/apikey and set it here.
# Without a key the site uses Pudding's offline dream generator and says so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Supabase migration path (only needed if you port the backend) ----
# Public browser values (safe to expose):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server ONLY. Never expose in the browser bundle or in git.
SUPABASE_SERVICE_ROLE_KEY=
